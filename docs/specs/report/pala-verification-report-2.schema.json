{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsests.dev/schemas/pala-verification-report-2.schema.json",
  "title": "pala-verification-report/2",
  "description": "The machine truth of the verification-report shape. One owner (palimpsests.audit.report); every rendering validates against this file, which ships inside the wheel. The report is an attestation of a check, never a compliance claim. Version fields (verifier.tool, verifier.package) and checked_at are normalized away by golden-file consumers. OPEN FORMAT: a release may add a key to any object here, and none is removed, renamed or given another meaning without a new format id — so this schema states what must be present and does not forbid what it does not name; a consumer ignores a key it does not know. The verdict set is closed. Differences from /1: docs/specs/report/MIGRATING-1-TO-2.md.",
  "type": "object",
  "required": [
    "format",
    "subject",
    "verifier",
    "checked_at",
    "chain",
    "container",
    "anchor",
    "completeness",
    "existence",
    "diagnosis",
    "advisory",
    "safety",
    "time_basis",
    "manifest",
    "verdict"
  ],
  "properties": {
    "format": {
      "const": "pala-verification-report/2"
    },
    "verdict": {
      "enum": [
        "sound",
        "partial",
        "empty",
        "violation"
      ],
      "description": "Produced ONLY by palimpsests.audit.report.derive_verdict; renderers must not re-derive the rule. A closed set: a new verdict is a new format id. 'empty' — the container holds no records: nothing was checked, and nothing was found intact; it is neither 'sound' nor 'partial'. An empty file that misses a supplied anchor is a 'violation'."
    },
    "subject": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "bytes",
        "records",
        "boots",
        "spans",
        "first_seq",
        "last_seq"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "boots": {
          "type": "integer",
          "minimum": 0
        },
        "spans": {
          "type": "integer",
          "minimum": 0
        },
        "first_seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "last_seq": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "required": [
        "tool",
        "package",
        "spec"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "The shell names itself (e.g. 'palimpsests-auditor X.Y.Z'). Normalized in golden tests."
        },
        "package": {
          "type": "string",
          "description": "Always names this package. Normalized in golden tests."
        },
        "spec": {
          "const": "PALA-1 v1.0"
        }
      }
    },
    "checked_at": {
      "type": "object",
      "required": [
        "wall_ns",
        "note"
      ],
      "description": "Isolated by design: two reports of one file diff to this object only.",
      "properties": {
        "wall_ns": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "container": {
      "type": "object",
      "required": [
        "well_formed",
        "malformed",
        "bytes_parsed",
        "bytes_total",
        "body_digest_mismatches"
      ],
      "description": "§2.4 well-formedness and the body↔header digest binding, attested by the report's own walk — a body swap is invisible to a header-only chain check.",
      "properties": {
        "well_formed": {
          "type": "boolean"
        },
        "malformed": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "body_digest_mismatches": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "required": [
        "chain_ok",
        "head",
        "breaks",
        "gaps",
        "violations",
        "uninterpretable",
        "violation_codes"
      ],
      "properties": {
        "chain_ok": {
          "type": "boolean"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "breaks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "violations": {
          "type": "array",
          "description": "[[seq, reason], …] — the reason is the verifier's sentence: carried verbatim, never parsed.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2
          }
        },
        "uninterpretable": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "violation_codes": {
          "type": "array",
          "description": "[[seq, code], …], parallel to violations: one entry per violation, same order. The code is what to branch on; the vocabulary is open.",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2
          }
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "head",
            "source_kind",
            "source_detail",
            "observed_at_ns",
            "attempts"
          ],
          "properties": {
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_kind": {
              "type": "string"
            },
            "source_detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at_ns": {
              "type": [
                "integer",
                "null"
              ],
              "description": "null when the anchor source does not carry an observation time (file/manual sources today)."
            },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source_kind",
                  "outcome",
                  "error"
                ],
                "properties": {
                  "source_kind": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "completeness": {
      "type": "object",
      "required": [
        "complete_to_anchor",
        "anchor_lag",
        "anchor_reason"
      ],
      "description": "Tri-state on purpose: null = NOT CHECKED and must never be rendered as passed (L7).",
      "properties": {
        "complete_to_anchor": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "anchor_lag": {
          "type": [
            "integer",
            "null"
          ]
        },
        "anchor_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "existence": {
      "type": "object",
      "required": [
        "external_pins",
        "note"
      ],
      "properties": {
        "external_pins": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "diagnosis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "pattern",
            "at_seq",
            "expected",
            "narrative",
            "code",
            "question"
          ],
          "properties": {
            "pattern": {
              "type": "string"
            },
            "at_seq": {
              "type": [
                "integer",
                "null"
              ]
            },
            "expected": {
              "type": [
                "string",
                "null"
              ]
            },
            "narrative": {
              "type": "string"
            },
            "code": {
              "type": [
                "string",
                "null"
              ],
              "description": "For the pattern record_violation: the violation's code, the field to branch on (expected carries its reason, a sentence). null for every other pattern."
            },
            "question": {
              "type": [
                "string",
                "null"
              ],
              "description": "Which of the questions the diagnosis is about: consistency — the file does not hold together as a chain, or does not begin where a chain begins; completeness — the chain holds together and the supplied anchor does not name its head; null — neither (empty_container), or a pattern the builder did not classify. A diagnosis being present does not by itself mean the chain is inconsistent: read this field, or chain and container."
            }
          }
        }
      ]
    },
    "manifest": {
      "description": "The segments manifest the diagnosis was decided against, when the first record declares a continuation. null — the verdict read no second file.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "filename",
            "status",
            "sha256",
            "detail"
          ],
          "properties": {
            "filename": {
              "type": [
                "string",
                "null"
              ],
              "description": "The manifest looked for, beside the subject file — its name, not a path. null when there was no path to derive it from."
            },
            "status": {
              "type": "string",
              "description": "As the diagnosis used it: matches, contradicts, declared_only. An open vocabulary."
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the manifest bytes that were read and judged — one read. null when no file was read."
            },
            "detail": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why the status is what it is, when that is not plain. A sentence."
            }
          }
        }
      ]
    },
    "advisory": {
      "type": "object",
      "required": [
        "count",
        "items",
        "note"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "at_seq",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "at_seq": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "note": {
          "const": "advisory items do not affect the verdict"
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "count",
        "unacknowledged_candidates",
        "items"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "unacknowledged_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seq",
              "kind",
              "kind_name"
            ],
            "properties": {
              "seq": {
                "type": "integer"
              },
              "kind": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "kind_name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "time_basis": {
      "type": "object",
      "required": [
        "axis",
        "wall_claims_qualified_by",
        "caveats"
      ],
      "properties": {
        "axis": {
          "const": "proved-order"
        },
        "wall_claims_qualified_by": {
          "const": "time_trust"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
