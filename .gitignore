*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
# any other venv name: hatchling builds the sdist from these rules, so an
# unignored .venv-something/ ends up inside it (81 MB, seen 2026-11-09)
.venv*/
venv*/

